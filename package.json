{
	"name": "codeloud-family",
	"version": "0.1.0",
	"private": true,
	"description": "CodeLoud family integration repository for Web, Voice, and Relay.",
	"type": "module",
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=22.22.2"
	},
	"workspaces": [
		"Web"
	],
	"scripts": {
		"check:web": "npm --prefix Web run check",
		"build:web": "npm --prefix Web run build",
		"dev:web": "npm --prefix Web run dev",
		"test:web": "npm --prefix Web run test",
		"lint:web": "npm --prefix Web run lint",
		"format:web": "npm --prefix Web run format:check",
		"inspect:web": "npm --prefix Web run browser:inspect",
		"check:relay-beta": "npm --prefix Web run browser:relay-beta",
		"deploy:web": "npm --prefix Web run deploy",
		"typecheck:voice": "npm --prefix Voice run check:root",
		"build:voice": "npm --prefix Voice run build",
		"test:voice:unit": "npm --prefix Voice run test:unit",
		"typecheck:relay": "npm --prefix Relay run typecheck",
		"build:relay": "npm --prefix Relay run build",
		"test:relay": "npm --prefix Relay run test",
		"check:products": "npm run typecheck:relay && npm run typecheck:voice",
		"typecheck": "npm run check:web",
		"lint": "npm run lint:web",
		"build": "npm run build:web",
		"test": "npm run test:web",
		"verify:web": "npm run format:web && npm run lint:web && npm run check:web && npm run test:web && npm run build:web && npm --prefix Web run check:worker"
	},
	"allowScripts": {
		"esbuild": true,
		"workerd": true
	}
}
