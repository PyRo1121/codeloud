{
	"name": "codeloud-family-site",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "oxlint --config oxlint.config.ts . && eslint . --max-warnings 0",
		"lint:oxlint": "oxlint --config oxlint.config.ts .",
		"lint:eslint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"deploy": "npm run build && npx wrangler deploy",
		"browser:inspect": "node scripts/browser-inspect.mjs"
	},
	"dependencies": {
		"@codeloud/family": "file:../Shared",
		"@effect/schema": "0.75.5",
		"@threlte/core": "8.5.16",
		"effect": "3.22.1",
		"svelte": "5.56.9",
		"three": "0.185.1",
		"zod": "4.4.3"
	},
	"overrides": {
		"cookie": "0.7.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260815.1",
		"@eslint/js": "10.0.1",
		"@oxlint/plugins": "1.78.0",
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/node": "24.10.1",
		"@vitest/coverage-v8": "4.1.10",
		"@vitest/eslint-plugin": "1.6.27",
		"eslint": "10.8.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.11.0",
		"oxlint": "1.78.0",
		"playwright-core": "1.62.1",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"svelte-check": "4.7.6",
		"svelte-eslint-parser": "1.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.67.0",
		"vite": "8.2.1",
		"vitest": "4.1.10",
		"wrangler": "4.123.0"
	}
}
